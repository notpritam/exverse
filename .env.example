# Exverse — environment
# Phase 0 (foundation) needs no environment variables: content is code and
# progress is local-first. The variables below land in later phases.

# --- Phase 1: accounts & progress sync ---
# DATABASE_URL=postgres://user:pass@host:5432/exverse   # any Postgres (Prisma); not Supabase
# AUTH_SESSION_SECRET=                                   # signs httpOnly session cookies

# --- Phase 2: AI tutor agents ---
# LLM_API_KEY=                                           # provider key for the in-lesson tutor
